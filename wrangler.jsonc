{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers static assets, mirroring the
  // moustacherepublic-web setup. Cloudflare Workers Builds runs
  // `npm run build` + `npx wrangler deploy` on every push to main.
  // out/_redirects and out/_headers apply at the edge.
  "name": "willowandpeony-web",
  "compatibility_date": "2026-09-30",
  // Handles POST /api/enquiry (form → email) and Next's `$` nav-data paths;
  // everything else is served straight from static assets.
  "main": "./worker/index.js",
  // staging.willowandpeony.co.nz serves the production deployment (the
  // Worker stamps it X-Robots-Tag: noindex). wrangler registers the DNS
  // record + certificate on deploy. The *.staging wildcard stays reserved
  // for per-branch preview aliases via the dashboard's Preview domain.
  "routes": [{ "pattern": "staging.willowandpeony.co.nz", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Everything flows through worker/index.js so preview hosts
    // (workers.dev, staging.*) get X-Robots-Tag: noindex on every path.
    "run_worker_first": true,
    // The site uses trailing-slash URLs (/faq/ serves faq/index.html).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the site's 404 page with a real 404 status.
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENQUIRY_TO": "hello@willowandpeony.co.nz",
    "ENQUIRY_FROM": "enquiries@willowandpeony.co.nz",
    "CALENDAR_FROM": "hello@willowandpeony.co.nz"
  }
  // Email is sent through Resend (free tier): set the RESEND_API_KEY secret
  // in the Cloudflare dashboard after verifying willowandpeony.co.nz in
  // Resend. Resend's DNS records live on subdomains only (send.,
  // resend._domainkey), so the Google Workspace MX on the apex is untouched.
  // Do NOT enable Cloudflare Email Routing on this zone: it rewrites the apex
  // MX and would break Ivy's Gmail inbox.
}
