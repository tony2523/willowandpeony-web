{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers static assets, mirroring the
  // moustacherepublic-web setup. Cloudflare Workers Builds runs
  // `npm run build` + `npx wrangler deploy` on every push to main.
  // out/_redirects and out/_headers apply at the edge.
  "name": "willowandpeony-web",
  "compatibility_date": "2026-09-30",
  // Handles POST /api/enquiry (form → email) and Next's `$` nav-data paths;
  // everything else is served straight from static assets.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Everything flows through worker/index.js so preview hosts
    // (workers.dev, staging.*) get X-Robots-Tag: noindex on every path.
    "run_worker_first": true,
    // The site uses trailing-slash URLs (/faq/ serves faq/index.html).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the site's 404 page with a real 404 status.
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENQUIRY_TO": "hello@willowandpeony.co.nz",
    // From lives on the mail. subdomain: Email Routing is enabled ONLY for
    // that subdomain, so the apex MX (Google Workspace — Ivy's real inbox)
    // is never touched. Do not enable Email Routing on the apex domain.
    "ENQUIRY_FROM": "enquiries@mail.willowandpeony.co.nz"
  },
  // Free Cloudflare Email Routing sending. Requires (dashboard, one-time):
  //  1. Zone → Email Routing → Settings → Subdomains → add "mail"
  //     (Cloudflare adds MX/SPF for mail.willowandpeony.co.nz only).
  //  2. Destination addresses → add hello@willowandpeony.co.nz → Ivy clicks
  //     the verification link (arrives in her Google mailbox).
  // Until then the Worker returns an error and the form falls back to a
  // pre-filled mail draft, so no enquiry is ever lost.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_destination_addresses": ["hello@willowandpeony.co.nz"]
    }
  ]
}
