{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers static assets, mirroring the
  // moustacherepublic-web setup. `npm run build` writes the site to out/;
  // Cloudflare Workers Builds runs the build and `npx wrangler deploy` on
  // every push to main. out/_redirects and out/_headers apply at the edge.
  "name": "willowandpeony",
  "compatibility_date": "2026-09-30",
  // Only handles Next.js navigation data requests (worker/index.js explains why).
  "main": "./worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/__next.*", "/*/__next.*"],
    // The site uses trailing-slash URLs (/faq/ serves faq/index.html).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the site's 404 page with a real 404 status.
    "not_found_handling": "404-page"
  }
}
